package Programa;

import java.util.Arrays;

public class Teste001 {

	public static void main(String[] args) {
		long startTime = System.nanoTime();
		
		int[] lista = {5, 3, 2, 1, 7, 4};
		
		System.out.println(Arrays.toString(lista));
		
		for (int cada : lista) {
			System.out.println(cada);
		}
		
		System.out.println("--------------------------");
		
		int max = maior(lista);
		System.out.println("o maior é: " + max);
		
		

		// Your code here
		long endTime = System.nanoTime();
		long duration = (endTime - startTime); // total time in nanoseconds

		//milliseconds
		System.out.println("Execution time: " + (duration / 1000000) + " ms");
		

	}
	
	public static int maior(int[] ls) {
		int a = ls[0];
		
		for (int cada : ls) {
			if (a < cada) {
				a = cada;
			}
		}
		return a;
	}
	
	public static int menor(int[] ls) {
		int b = ls[0];
		
		for (int cada : ls) {
			if (b > cada) {
				b = cada;
			}
		}
		return b;
	}
	
	
	

}

